{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", "schedule:daily"],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "matchPackageNames": ["@openai/codex", "@anthropic-ai/claude-code", "opencode-ai", "opencode-gemini-auth", "antigravity-cli"],
      "schedule": ["at any time"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "rebase"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node", "ghcr.io/astral-sh/uv"],
      "matchUpdateTypes": ["digest", "minor", "patch"],
      "groupName": "toolchain",
      "schedule": ["before 4am on monday"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "rebase"
    },
    {
      "matchDatasources": ["github-releases", "custom.gcloud-sdk"],
      "groupName": "toolchain",
      "schedule": ["before 4am on monday"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "rebase"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile(\\.[a-z]+)?$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)\\s+ARG [A-Z_]+_VERSION=(?<currentValue>[^\\s]+)"],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "customDatasources": {
    "antigravity-cli": {
      "defaultRegistryUrlTemplate": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json",
      "format": "json",
      "transformTemplates": ["{\"releases\": [{\"version\": version}]}"]
    },
    "gcloud-sdk": {
      "defaultRegistryUrlTemplate": "https://dl.google.com/dl/cloudsdk/channels/rapid/components-2.json",
      "format": "json",
      "transformTemplates": ["{\"releases\": [{\"version\": version}]}"]
    }
  }
}
